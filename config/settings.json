{
  "version": 1,
  "skillsRoot": "../vaniecom-workspace/skills",
  "research": {
    "delay_seconds": [
      5,
      15
    ],
    "dedupe": {
      "image_distance": 20,
      "caption_similarity": 0.9
    },
    "browser": {
      "cdp": "http://127.0.0.1:9222",
      "user_data_dir": "",
      "channel": "chrome",
      "fallback_tabs": [
        "posts",
        "photos",
        "reels"
      ],
      "stall_posts": 5,
      "max_scroll_steps": 300
    }
  },
  "codex": {
    "command": "codex",
    "timeout_minutes": 15
  },
  "imageHost": {
    "type": "github-repo",
    "path": "../social-autopilot-sources",
    "pagesBase": "",
    "rawBase": "https://raw.githubusercontent.com/<owner>/<image-repo>/main",
    "branch": "main",
    "remote": "origin",
    "auto_after_writeback": true,
    "verify": {
      "attempts": 18,
      "delay_seconds": 10
    }
  },
  "ffmpeg": {
    "command": "ffmpeg"
  },
  "remove_watermark": {
    "script": "../remove-watermark-skill/scripts/strip-png-metadata.mjs",
    "providers": {
      "codex": "chatgpt"
    }
  },
  "planning": {
    "ahead_days": 7
  }
}
