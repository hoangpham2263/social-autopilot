{
  "version": 1,
  "skillsRoot": "../vaniecom-workspace/skills",
  "research": {
    "delay_seconds": [
      5,
      15
    ],
    "dedupe": {
      "image_distance": 20,
      "caption_similarity": 0.9
    },
    "scroll_wait_seconds": {
      "pinterest": [
        2,
        4
      ],
      "houzz": [
        2,
        4
      ],
      "etsy": [
        2,
        4
      ],
      "instagram": [
        5,
        10
      ],
      "facebook": [
        5,
        10
      ]
    }
  },
  "codex": {
    "command": "codex",
    "timeout_minutes": 15,
    "concurrency": 3,
    "retry_wait_seconds": 60
  },
  "imageHost": {
    "type": "github-repo",
    "path": "workspace/image-host",
    "remote_url": "",
    "pagesBase": "",
    "rawBase": "https://raw.githubusercontent.com/<owner>/<image-repo>/main",
    "branch": "main",
    "remote": "origin",
    "auto_after_writeback": true,
    "verify": {
      "attempts": 18,
      "delay_seconds": 10
    }
  },
  "ffmpeg": {
    "command": "ffmpeg"
  },
  "remove_watermark": {
    "script": "../remove-watermark-skill/scripts/strip-png-metadata.mjs",
    "providers": {
      "codex": "chatgpt"
    }
  },
  "planning": {
    "ahead_days": 7
  },
  "ideas": {
    "reuse_cooldown_days": 7,
    "suggest_remove_after": 0
  },
  "posts": {
    "images_per_post": [
      1,
      3
    ]
  }
}
